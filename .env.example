# 이 파일을 복사해 .env.local 로 저장하고 값을 채우기 (Vercel 에는 같은 이름으로 Environment Variables 에 입력)
# Supabase 대시보드 > Project Settings > API Keys / Data API 에서 확인

# 프로젝트 URL (뒤에 /rest/v1/ 이 붙어 있어도 됨)
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# anon 키 (Legacy API Keys 탭의 anon public) — 브라우저에 공개되어도 되는 키
# service_role 키는 절대 넣지 않기 (넣으면 사이트에 접속한 누구나 DB 를 지울 수 있음)
VITE_SUPABASE_ANON_KEY=
