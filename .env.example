# 이 파일을 복사해 .env.local 로 저장하고 값을 채우기
# Supabase 대시보드 > Project Settings > API Keys > Legacy API Keys 에서 확인
# Vercel 에는 VITE_ 로 시작하는 두 개만 입력 (service_role 은 넣지 않기)

# 프로젝트 URL (뒤에 /rest/v1/ 이 붙어 있어도 됨)
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# anon public 키 — 웹페이지에 들어가는 공개용 키
VITE_SUPABASE_ANON_KEY=

# service_role 키 — VITE_ 가 없어서 웹페이지에는 들어가지 않음 (보관용, 앱에서는 사용 안 함)
SUPABASE_SERVICE_ROLE_KEY=
